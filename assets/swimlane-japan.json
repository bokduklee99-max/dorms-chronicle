{"events":[{"id":"E187","row":169,"date":"1919-11","title":"의열단 결성","type":"event","period":"문화 통치","arcs":["만주·연해주"],"themes":[],"body":"김원봉 등 독립운동가들이 중국 지린에서 의열단을 결성했다.","media":"","place":"만주·연해주","actors":[{"name":"의열단","role":"related"},{"name":"김원봉","role":"founder"}],"importance":"core"},{"id":"E188","row":170,"date":"1921-09","title":"김익상의 조선총독부 의거","type":"event","period":"문화 통치","arcs":["중국 관내"],"themes":["국내 민족운동"],"body":"의열단원 김익상이 경성의 조선총독부 청사를 대상으로 의거를 벌였다.","media":"","place":"서울","actors":[{"name":"의열단","role":"initiator"},{"name":"김익상","role":"executor"}],"importance":"detail"},{"id":"E189","row":171,"date":"1923-01","title":"조선혁명선언 발표","type":"publication","period":"문화 통치","arcs":["중국 관내"],"themes":[],"body":"의열단의 요청으로 신채호가 작성한 선언으로, 민중이 주체가 되는 독립운동의 방향을 제시했다.","media":"","place":"상하이, 중국 관내","actors":[{"name":"의열단","role":"initiator"},{"name":"신채호","role":"author"}],"importance":"major"},{"id":"E190","row":172,"date":"1923-01","title":"김상옥 의거","type":"event","period":"문화 통치","arcs":["중국 관내"],"themes":["국내 민족운동"],"body":"의열단원 김상옥이 경성에서 항일 의거를 전개했다. 일제 경찰의 추적에 맞서다가 1월 22일 효제동에서 순국했다.","media":"","place":"서울","actors":[{"name":"의열단","role":"related"},{"name":"김상옥","role":"executor"}],"importance":"detail"},{"id":"E191","row":173,"date":"1926-03","title":"의열단원들의 황푸군관학교 입교","type":"event","period":"문화 통치","arcs":["중국 관내"],"themes":[],"body":"김원봉과 여러 의열단원이 중국 광저우의 황푸군관학교 4기생으로 입교해 군사·정치 교육을 받았다.","media":"","place":"중국 관내","actors":[{"name":"의열단","role":"related"},{"name":"황푸군관학교","role":"participant"},{"name":"김원봉","role":"participant"}],"importance":"major"},{"id":"E192","row":174,"date":"1926-12-28","title":"나석주의 동양척식주식회사·조선식산은행 의거","type":"event","period":"문화 통치","arcs":["중국 관내"],"themes":["국내 민족운동"],"body":"의열단에 참여했던 나석주가 김창숙의 지원을 받아 경성의 식민지 경제 수탈 기관에 맞서 의거를 벌였다.","media":"","place":"서울","actors":[{"name":"의열단","role":"related"},{"name":"나석주","role":"executor"}],"importance":"major"},{"id":"E193","row":175,"date":"1932-10-20","title":"조선혁명군사정치간부학교 개교","type":"event","period":"민족 말살 정책","arcs":["중국 관내"],"themes":[],"body":"김원봉과 의열단이 중국 국민정부의 지원으로 난징에 독립운동 간부 양성 기관을 마련했다. 이날 제1기 입교식에서 김원봉이 개교사를 했다.","media":"","place":"난징, 중국 관내","actors":[{"name":"의열단","role":"initiator"},{"name":"조선혁명군사정치간부학교","role":"related"},{"name":"김원봉","role":"leader"}],"importance":"major"},{"id":"E194","row":176,"date":"1935-07-05","title":"민족혁명당 창당","type":"event","period":"민족 말살 정책","arcs":["중국 관내"],"themes":[],"body":"난징에서 의열단 등 여러 독립운동단체의 통합으로 민족혁명당이 창당됐다.","media":"","place":"난징, 중국 관내","actors":[{"name":"의열단","role":"participant"},{"name":"민족혁명당","role":"related"},{"name":"김원봉","role":"participant"}],"importance":"major"},{"id":"E195","row":177,"date":"1938-10-10","title":"조선의용대 창설","type":"event","period":"민족 말살 정책","arcs":["중국 관내"],"themes":[],"body":"중국 우한에서 조선민족전선연맹의 무장조직인 조선의용대가 창설됐다. 김원봉이 총대장을 맡았다.","media":"","place":"중국 관내","actors":[{"name":"민족혁명당","role":"participant"},{"name":"조선의용대","role":"related"},{"name":"김원봉","role":"leader"}],"importance":"core"},{"id":"E196","row":178,"date":"1940-09-17","title":"한국광복군 창설","type":"event","period":"대한민국 임시정부 충칭 시기","arcs":["중국 관내"],"themes":[],"body":"대한민국 임시정부가 충칭에서 한국광복군 총사령부 성립 전례식을 열었다. 지청천이 총사령을 맡았다.","media":"","place":"충칭, 중국 관내","actors":[{"name":"한국광복군","role":"related"},{"name":"지청천","role":"leader"},{"name":"대한민국 임시정부","role":"initiator"}],"importance":"core"},{"id":"E197","row":179,"date":"1940","title":"조선의용대 일부 대원의 화북 이동","type":"event","period":"민족 말살 정책","arcs":["중국 관내"],"themes":[],"body":"1940년 말부터 1941년 상반기에 걸쳐 조선의용대 대원들이 화북으로 이동했다. 이후 이들은 화북지대의 기반이 됐다.","media":"","place":"중국 관내","actors":[{"name":"조선의용대","role":"participant"}],"importance":"detail"},{"id":"E198","row":180,"date":"1942-05","title":"조선의용대 충칭 본부의 한국광복군 편입","type":"event","period":"대한민국 임시정부 충칭 시기","arcs":["중국 관내"],"themes":[],"body":"중국 국민정부 군사위원회가 5월 조선의용대의 광복군 합류를 명령했다. 충칭 본부와 잔류 대원이 한국광복군 제1지대로 재편되는 계기가 됐다.","media":"","place":"충칭, 중국 관내","actors":[{"name":"조선의용대","role":"affected"},{"name":"한국광복군","role":"participant"}],"importance":"major"},{"id":"E199","row":181,"date":"1942-07-10","title":"화북조선독립동맹 결성","type":"event","period":"민족 말살 정책","arcs":["중국 관내"],"themes":[],"body":"화북조선청년연합회가 대회를 열어 조선독립동맹으로 확대 개편됐다. 김두봉이 중심 역할을 맡았다.","media":"","place":"중국 관내","actors":[{"name":"조선독립동맹","role":"related"},{"name":"김두봉","role":"leader"}],"importance":"major"},{"id":"E200","row":182,"date":"1942-07-10","title":"조선의용대 화북지대의 조선의용군 개편","type":"event","period":"민족 말살 정책","arcs":["중국 관내"],"themes":[],"body":"화북의 조선의용대 지대가 조선의용군으로 개편되어 조선독립동맹 산하에 들어갔다.","media":"","place":"중국 관내","actors":[{"name":"조선의용대","role":"affected"},{"name":"조선독립동맹","role":"participant"},{"name":"조선의용군","role":"related"}],"importance":"core"},{"id":"E201","row":183,"date":"1943-08","title":"한국광복군 인면전구공작대 인도 파견","type":"event","period":"대한민국 임시정부 충칭 시기","arcs":["연합군 협력"],"themes":[],"body":"한국광복군이 인면전구공작대를 인도에 파견했다. 공작대는 이후 영국군과 협력해 인도·미얀마 방면에서 활동했다.","media":"","place":"중국 관내, 동아시아","actors":[{"name":"한국광복군","role":"initiator"}],"importance":"major"},{"id":"E202","row":184,"date":"1945-05","title":"한국광복군과 OSS의 국내 진공 작전 준비","type":"event","period":"대한민국 임시정부 충칭 시기","arcs":["연합군 협력"],"themes":[],"body":"한국광복군 제2지대와 미국 OSS의 합동 훈련이 5월에 본격화됐다. 이 계획은 독수리 작전으로 불렸으며 일본의 항복으로 실행에 이르지 못했다.","media":"","place":"중국 관내, 한반도","actors":[{"name":"한국광복군","role":"participant"}],"importance":"major"},{"id":"E206","row":185,"date":"1910","end":"1919","title":"헌병 경찰제","type":"policy","period":"무단 통치","arcs":[],"themes":["통치 정책"],"body":"헌병 경찰제","media":"","place":"한반도","actors":[],"importance":"core"},{"id":"E207","row":186,"date":"1919","end":"1945","title":"보통 경찰제","type":"policy","period":"문화 통치","arcs":[],"themes":["통치 정책"],"body":"보통 경찰제 — 경찰 수·관서는 오히려 증가","media":"","place":"한반도","actors":[],"importance":"major"},{"id":"E208","row":187,"date":"1912","end":"1920","title":"조선 태형령 (한국인만)","type":"policy","period":"무단 통치","arcs":[],"themes":["통치 정책"],"body":"조선 태형령 (한국인만)","media":"","place":"한반도","actors":[