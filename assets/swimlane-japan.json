동맹으로도 불리며, 조선의용군을 산하에 두었다.","kind":"organization","place":"옌안, 중국 관내"},{"id":"org_korean_volunteer_army","title":"조선의용군","start":"1942-07","end":"","body":"조선의용대 화북지대를 바탕으로 개편된 조선독립동맹 산하 무장조직. 무정이 사령관을 맡았다.","kind":"army","place":"옌안, 만주·연해주"},{"id":"org_korean_liberation_army","title":"한국광복군","start":"1940-09-17","end":"1946-05-16","body":"대한민국 임시정부가 충칭에서 창설한 정규군. 1942년 조선의용대 충칭 본부와 잔류 대원이 편입되었고 김원봉이 부사령을 맡았다.","kind":"army","place":"충칭, 중국 관내"},{"id":"org_singanhoe","title":"신간회","start":"1927-02","end":"1931-05","body":"비타협적 민족주의자와 사회주의자가 함께 결성한 단체.","kind":"organization","place":"서울, 한반도"},{"id":"org_korean_patriotic_group","title":"한인애국단","start":"1931","end":"","body":"김구가 이끈 대한민국 임시정부 산하 조직.","kind":"organization","place":"상하이, 중국 관내"}],"relations":[{"id":"R001","row":2,"kind":"cause","label":"임시정부 수립의 계기","body":"3·1 운동 이후 상하이에서 대한민국 임시정부가 수립되었다.","source":"https://encykorea.aks.ac.kr/Article/E0026772","status":"draft","fromType":"event","fromId":"E248","fromName":"3·1 운동","toType":"event","toId":"E306","toName":"대한민국 임시정부 수립","visible":true},{"id":"R002","row":3,"kind":"shift","label":"통치 방식의 전환","body":"3·1 운동 이후 일제가 식민 통치 방식을 이른바 문화 통치로 바꾸었다.","source":"https://contents.history.go.kr/mobile/kc/view.do?levelId=kc_o400350","status":"verified","fromType":"event","fromId":"E248","fromName":"3·1 운동","toType":"category","toId":"japan_cultural_rule","toName":"문화 통치","visible":true},{"id":"R003","row":4,"kind":"action","label":"의열단원 입교","body":"김원봉 등 의열단원이 1926년 황푸군관학교 4기생으로 입교했다.","source":"https://db.history.go.kr/modern/level.do?levelId=hdsr_011_0080_0020","status":"draft","fromType":"actor","fromId":"org_uiyeoldan","fromName":"의열단","toType":"actor","toId":"org_whampoa_military_academy","toName":"황푸군관학교","visible":true},{"id":"R004","row":5,"kind":"action","label":"간부학교 설립","body":"의열단이 중국 국민정부의 지원을 받아 난징에서 학교를 운영했다.","source":"https://db.history.go.kr/diachronic/level.do?levelId=kn_018_0070_0050_0010","status":"draft","fromType":"actor","fromId":"org_uiyeoldan","fromName":"의열단","toType":"actor","toId":"org_korean_revolutionary_cadre_school","toName":"조선혁명군사정치간부학교","visible":true},{"id":"R005","row":6,"kind":"integration","label":"통합 창당 참여","body":"의열단 등 여러 단체가 통합해 민족혁명당을 결성했다.","source":"https://db.history.go.kr/id/ij_040_0020_02420","status":"draft","fromType":"actor","fromId":"org_uiyeoldan","fromName":"의열단","toType":"actor","toId":"org_minjok_revolution","toName":"민족혁명당","visible":true},{"id":"R006","row":7,"kind":"action","label":"창설 참여","body":"민족혁명당은 조선민족전선연맹에 참여했고 조선의용대 창설에 관여했다.","source":"https://db.history.go.kr/diachronic/level.do?levelId=kn_018_0070_0060_0040","status":"draft","fromType":"actor","fromId":"org_minjok_revolution","fromName":"민족혁명당","toType":"actor","toId":"org_korean_volunteer_corps","toName":"조선의용대","visible":true},{"id":"R007","row":8,"kind":"split","label":"화북지대 개편","body":"화북으로 이동한 조선의용대 지대가 1942년 7월 조선의용군으로 개편됐다.","source":"https://db.history.go.kr/diachronic/level.do?levelId=kn_023_0080_0030_0040","status":"draft","fromType":"actor","fromId":"org_korean_volunteer_corps","fromName":"조선의용대","toType":"actor","toId":"org_korean_volunteer_army","toName":"조선의용군","visible":true},{"id":"R008","row":9,"kind":"integration","label":"충칭 본부 편입","body":"충칭 본부와 잔류 대원이 광복군 제1지대로 편입됐다.","source":"https://db.history.go.kr/modern/level.do?levelId=ij_012_%241exp","status":"draft","fromType":"actor","fromId":"org_korean_volunteer_corps","fromName":"조선의용대","toType":"actor","toId":"org_korean_liberation_army","toName":"한국광복군","visible":true},{"id":"R009","row":10,"kind":"action","label":"산하 무장조직","body":"화북조선독립동맹이 조선의용군을 산하에 두었다.","source":"https://db.history.go.kr/diachronic/level.do?levelId=kn_054_0070_0020_0010","status":"draft","fromType":"actor","fromId":"org_korean_independence_league","fromName":"조선독립동맹","toType":"actor","toId":"org_korean_volunteer_army","toName":"조선의용군","visible":true},{"id":"R010","row":11,"kind":"action","label":"이봉창 의거","body":"한인애국단원 이봉창이 도쿄에서 의거를 결행했다.","source":"https://db.history.go.kr/modern/level.do?levelId=ij_029_%241exp","status":"draft","fromType":"actor","fromId":"org_korean_patriotic_group","fromName":"한인애국단","toType":"event","toId":"E304","toName":"이봉창 의거","visible":true},{"id":"R011","row":12,"kind":"action","label":"윤봉길 의거","body":"한인애국단원 윤봉길이 상하이에서 의거를 결행했다.","source":"https://db.history.go.kr/modern/level.do?levelId=ij_029_%241exp","status":"draft","fromType":"actor","fromId":"org_korean_patriotic_group","fromName":"한인애국단","toType":"event","toId":"E305","toName":"윤봉길 의거","visible":true},{"id":"R012","row":13,"kind":"action","label":"진상 조사·지원","body":"신간회가 진상 조사단을 파견하고 학생들의 항쟁을 지원했다.","source":"https://encykorea.aks.ac.kr/Article/E0032606","status":"draft","fromType":"actor","fromId":"org_singanhoe","fromName":"신간회","toType":"event","toId":"E260","toName":"광주 학생 항일 운동","visible":true},{"id":"R041","row":42,"kind":"background","label":"3·1 운동의 국제적 배경","body":"윌슨의 민족자결주의 제창과 2·8 독립선언이 3·1 운동이 거족적으로 폭발하는 직접적인 사상적·국제적 배경이 되었다.","source":"https://encykorea.aks.ac.kr/Article/E0026772","status":"verified","fromType":"event","fromId":"E309","fromName":"민족 자결주의","toType":"event","toId":"E248","toName":"3·1 운동","visible":true},{"id":"R042","row":43,"kind":"background","label":"민족자결주의 대두 배경","body":"제1차 세계대전의 종전과 전후 질서 재편 과정에서 미국 윌슨 대통령이 전후 평화 원칙으로 민족자결주의를 천명했다.","source":"","status":"verified","fromType":"event","fromId":"E308","fromName":"제1차 세계 대전","toType":"event","toId":"E309","toName":"민족 자결주의","visible":true},{"id":"R043","row":44,"kind":"background","label":"만주사변의 경제적 배경","body":"1929년 대공황으로 경제적 파탄에 직면한 일본 군부가 대륙 침략을 통해 위기를 극복하고자 만주사변을 도발했다.","source":"","status":"verified","fromType":"event","fromId":"E310","fromName":"대공황","toType":"event","toId":"E312","toName":"만주사변","visible":true},{"id":"R044","row":45,"kind":"background","label":"병참기지화의 직접 배경","body":"만주사변 이후 일본이 만주를 교두보로 삼고 한반도를 대륙 침략을 위한 병참 기지로 전환하기 시작했다.","source":"","status":"verified","fromType":"event","fromId":"E312","fromName":"만주사변","toType":"event","toId":"E235","toName":"병참 기지화","visible":true},{"id":"R045","row":46,"kind":"background","label":"국가총동원법 제정 배경","body":"중일전쟁이 장기화되자 일제가 전면적인 전쟁 수행을 위해 인적·물적 자원을 총동원하는 국가총동원법을 제정했다.","source":"","status":"verified","fromType":"event","fromId":"E313","fromName":"중일 전쟁","toType":"event","toId":"E233","toName":"전시 통제 경제 (국가 총동원법)","visible":true},{"id":"R046","row":47,"kind":"background","label":"조선의용대 창설 배경","body":"중일전쟁 발발 이후 중국 국민정부의 지원과 항일 공조 속에서 중국 관내 최초의 한인 무장부대인 조선의용대가 창설됐다.","source":"","status":"verified","fromType":"event","fromId":"E313","fromName":"중일 전쟁","toType":"event","toId":"E195","toName":"조선의용대 창설","visible":true},{"id":"R047","row":48,"kind":"background","label":"학도지원병 및 징병제 배경","body":"태평양 전쟁 발발로 전선이 확대되고 병력 부족이 극심해지자 학도지원병제와 징병제를 시행해 조선 청년들을 전선에 동원했다.","source":"","status":"verified","fromType":"event","fromId":"E314","fromName":"태평양 전쟁","toType":"event","toId":"E228","toName":"학도 지원병제","visible":true}]}
